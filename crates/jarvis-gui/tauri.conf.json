{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS ALTRON",
  "version": "1.1.16",
  "identifier": "com.diberlog.jarvis.syncv2lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../frontend" },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../frontend/dist/client"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": false,
        "visible": false,
        "title": "JARVIS ALTRON",
        "width": 1040,
        "height": 800,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../resources/icons/32x32.png",
      "../../resources/icons/128x128.png",
      "../../resources/icons/128x128@2x.png",
      "../../resources/icons/icon.icns",
      "../../resources/icons/icon.ico"
    ],
    "targets": "all",
    "resources": {
      "../../resources/commands": "resources/commands",
      "../../resources/sound": "resources/sound",
      "../../resources/tts/AudioOutput.py": "resources/tts/AudioOutput.py",
      "../../resources/tts/SileroSpeak.py": "resources/tts/SileroSpeak.py",
      "../../resources/tts/XttsSpeak.py": "resources/tts/XttsSpeak.py",
      "../../resources/tts/S2Speak.py": "resources/tts/S2Speak.py",
      "../../resources/rustpotter": "resources/rustpotter",
      "../../resources/vosk": "resources/vosk",
      "../../resources/keywords": "resources/keywords"
    }
  }
}
